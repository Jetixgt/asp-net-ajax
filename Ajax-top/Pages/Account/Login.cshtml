@page
@model aspnetWebApp.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="form-container">
    <h1>Вход</h1>
    <p class="description">Войди, чтобы создавать и редактировать резюме</p>

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Input.Email">Email:</label>
            <input asp-for="Input.Email" type="email" placeholder="email@example.com" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Password">Пароль:</label>
            <input asp-for="Input.Password" type="password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>
                <input asp-for="Input.RememberMe" type="checkbox" />
                Запомнить меня
            </label>
        </div>

        <button class="form-button" type="submit">Войти</button>
        <p class="auth-switch">Нет аккаунта? <a asp-page="/Account/Register">Зарегистрироваться</a></p>
    </form>
</div>

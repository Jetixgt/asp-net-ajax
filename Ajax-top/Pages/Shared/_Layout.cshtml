<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CollegeJob</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="header-container">
            <a class="site-logo" asp-page="/Index">
                College<span>Job</span>
            </a>
            <nav class="site-nav" aria-label="Основная навигация">
                <a asp-page="/Index">Главная</a>
                <a asp-page="/Index" asp-fragment="form">Анкета</a>
                <a asp-page="/Index" asp-fragment="about">О проекте</a>
            </nav>
        </div>
    </header>

    <main role="main" class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-container">
            <a class="footer-logo" asp-page="/Index">
                College<span>Job</span>
            </a>
            <p>Анкета для знакомства с будущими специалистами</p>
            <span class="footer-copy">
                © @DateTime.Now.Year CollegeJob
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
